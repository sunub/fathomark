{
  "name": "fathomark-plugin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "The Fathomark Obsidian plugin: Chat UI, Agent Harness, context pipeline, tools, and Obsidian adapters. Everything here ships as one main.js.",
  "scripts": {
    "dev": "node build.mjs",
    "build": "node build.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "@fathomark/design-system": "workspace:*",
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "builtin-modules": "^4.0.0",
    "dependency-cruiser": "^16.0.0",
    "esbuild": "^0.25.0",
    "happy-dom": "^15.11.0",
    "obsidian": "latest",
    "tailwindcss": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
